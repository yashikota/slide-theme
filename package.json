{
  "name": "slidev-theme-kota",
  "version": "1.0.0",
  "description": "研究進捗報告向けの Slidev テーマ。UDEV Gothic、本文の自動縮小、BudouX の日本語改行、ページ番号と進捗バーを備える。",
  "private": true,
  "type": "module",
  "repository": "github:yashikota/slide-theme",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0",
    "slidev": ">=53.0.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png",
    "test": "node --test"
  },
  "slidev": {
    "defaults": {
      "colorSchema": "light",
      "aspectRatio": "16/9",
      "canvasWidth": 1280,
      "fonts": {
        "provider": "none",
        "sans": "UDEV Gothic",
        "mono": "UDEV Gothic"
      }
    }
  },
  "dependencies": {
    "budoux": "0.9.3"
  },
  "devDependencies": {
    "@slidev/cli": "53.0.0",
    "playwright-chromium": "1.64.0"
  }
}
